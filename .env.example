# Copia este archivo como .env y completa con tus datos reales.
# NUNCA subas el archivo .env real al repositorio (ya está en .gitignore).

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# True solo en desarrollo local. En producción debe ser False.
DEBUG=True

# Dominios/IPs desde los que se puede servir la app, separados por coma.
# En Render no hace falta agregar el dominio .onrender.com: se toma solo de RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos.
# En local NO hace falta nada: si DATABASE_URL está vacía se usa SQLite (archivo db.sqlite3).
# En Render, DATABASE_URL la pone Render automáticamente con la URL de PostgreSQL.
# Si quieres trabajar en local contra la base de Render, pega aquí su "External Database URL":
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# Backend de correo. En desarrollo se imprime en la consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
